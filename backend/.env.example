PORT=5000
NODE_ENV=development

DATABASE_URL=your_database_url
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=5000

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-latest
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BASE_MS=500
GEMINI_REQUEST_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=1200
AI_TEMPERATURE=0.65

CHAT_HISTORY_MAX_MESSAGES=12
CHAT_HISTORY_MAX_CHARS=24000
MAX_USER_MESSAGE_CHARS=12000
MAX_ACTIVE_CONTEXTS=3
CONTEXT_CACHE_TTL_MS=60000
AI_SETTINGS_CACHE_TTL_MS=30000
ENABLE_PERF_LOGGING=false

JWT_SECRET=your_jwt_secret